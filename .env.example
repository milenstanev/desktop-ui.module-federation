# Desktop UI Environment Variables

# PWA Configuration
# Set to 'true' to enable PWA features (service worker, offline support)
# Default: enabled in production, disabled in development
REACT_APP_ENABLE_PWA=false

# Performance Monitoring
# Set to 'true' to enable Web Vitals logging in development
REACT_APP_ENABLE_VITALS_LOGGING=true

# Google Analytics 4
# Your GA4 Measurement ID (e.g. G-XXXXXXXXXX). Web Vitals and pageviews are sent when set in production.
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Bundle Analysis
# Set to 'true' when building to generate bundle size report
# Usage: ANALYZE=true npm run build
# ANALYZE=false

# Micro-Frontends: analytics remote base URL (without /remoteEntry.js)
# Local default: http://localhost:3002
# Production default when unset: {window.location.origin}/remote
# (Vercel microfrontends routing). Set this to a dedicated analytics
# deployment URL if the remote is not served from /remote.
# REACT_APP_ANALYTICS_REMOTE_URL=http://localhost:3002
# Vercel example (analytics remote project):
# REACT_APP_ANALYTICS_REMOTE_URL=https://analytics-remote-yourteam.vercel.app

# Schema UI forms remote (Vite Module Federation, container schemaUi)
# Default: https://schema-ui-mf-remote.vercel.app
# REACT_APP_SCHEMA_UI_REMOTE_URL=https://schema-ui-mf-remote.vercel.app
