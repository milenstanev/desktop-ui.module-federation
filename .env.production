# Production Environment Configuration

# Enable PWA in production for offline support
REACT_APP_ENABLE_PWA=true

# Disable Web Vitals console logging in production
# Send to analytics service (Google Analytics) instead
REACT_APP_ENABLE_VITALS_LOGGING=false

# Google Analytics 4 - set in the host (Vercel env), not in git
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Micro-Frontends: analytics remote base URL (without /remoteEntry.js)
# Leave unset to use {origin}/remote (Vercel microfrontends routing).
# Do not point this at the desktop-ui host origin root — that serves
# the host's own remoteEntry.js (container "desktopUI"), not "analytics".
# Example dedicated remote:
# REACT_APP_ANALYTICS_REMOTE_URL=https://analytics-remote-yourteam.vercel.app
